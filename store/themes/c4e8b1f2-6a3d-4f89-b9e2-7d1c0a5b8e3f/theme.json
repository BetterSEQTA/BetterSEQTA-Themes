{"id":"c4e8b1f2-6a3d-4f89-b9e2-7d1c0a5b8e3f","name":"straight brainrot","description":"my pintrest lmao","defaultColour":"rgb(244, 114, 182)","CanChangeColour":true,"allowBackgrounds":false,"hideThemeName":false,"CustomCSS":"/* straight brainrot — wallpaper on body (XP / Rainforest pattern), UI above it */\n\n:root {\n  --vro-bg-url: url(\"https://betterseqta.org/api/background.webp\");\n  --vro-glass: rgba(12, 12, 18, 0.72);\n  --vro-glass-soft: rgba(12, 12, 18, 0.55);\n  --vro-border: rgba(255, 255, 255, 0.14);\n}\n\nhtml {\n  min-height: 100% !important;\n  background-color: #0a0a10 !important;\n}\n\nhtml.dark {\n  --background-primary: rgba(18, 18, 26, 0.88);\n  --background-secondary: rgba(28, 28, 38, 0.9);\n  --theme-primary: rgba(18, 18, 26, 0.88);\n  --theme-secondary: rgba(28, 28, 38, 0.9);\n  --text-primary: #f4f4f8;\n  --text-color: #f4f4f8;\n}\n\nhtml:not(.dark) {\n  --background-primary: rgba(255, 255, 255, 0.88);\n  --background-secondary: rgba(245, 245, 250, 0.9);\n  --theme-primary: rgba(255, 255, 255, 0.88);\n  --theme-secondary: rgba(245, 245, 250, 0.9);\n  --text-primary: #1a1a22;\n  --text-color: #1a1a22;\n}\n\n/* Blurred bleed in letterbox gaps (behind sharp body background) */\nbody::before {\n  content: \"\";\n  position: fixed;\n  inset: -15%;\n  z-index: -1;\n  pointer-events: none;\n  background-image: var(--vro-bg-url, var(--vro-bg-fallback));\n  background-size: cover;\n  background-position: center;\n  filter: blur(48px) saturate(1.25);\n  transform: scale(1.1);\n}\n\n/* Sharp centred wallpaper — inset on pseudo only (no body padding on SEQTA UI) */\nbody::after {\n  content: \"\";\n  position: fixed;\n  inset: clamp(12px, 3vw, 48px);\n  z-index: -1;\n  pointer-events: none;\n  background-image: var(--vro-bg-url, var(--vro-bg-fallback));\n  background-repeat: no-repeat;\n  background-position: center center;\n  background-size: contain;\n}\n\nhtml.dark body,\nhtml:not(.dark) body {\n  background-color: transparent !important;\n  background-image: none !important;\n}\n\n@media (max-width: 900px) {\n  body::after {\n    inset: clamp(8px, 2vw, 24px);\n  }\n}\n\n\n#container {\r\n  background: unset !important;\r\n}\r\n\r\n#container > .bg {\r\n  background: transparent !important;\r\n  opacity: 0 !important;\r\n  pointer-events: none !important;\r\n}\r\n\r\n#content {\r\n  background: transparent !important;\r\n}\r\n\r\n#title {\r\n  position: fixed !important;\r\n  top: 0 !important;\r\n  left: 0 !important;\r\n  width: 100% !important;\r\n  height: 71px !important;\r\n  min-height: 71px !important;\r\n  display: flex !important;\r\n  justify-content: space-between !important;\r\n  align-items: center !important;\r\n  box-sizing: border-box !important;\r\n  padding-right: 56px !important;\r\n  z-index: 20 !important;\r\n  background: var(--vro-glass) !important;\r\n  color: var(--text-primary) !important;\r\n  border-bottom: 1px solid var(--vro-border) !important;\r\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35) !important;\r\n  backdrop-filter: blur(20px) saturate(1.2);\r\n}\r\n\r\n#title * {\r\n  color: var(--text-primary) !important;\r\n}\r\n\r\n.titlebar {\r\n  background: transparent !important;\r\n  z-index: 21 !important;\r\n}\r\n\r\n.connectedNotificationsWrapper {\r\n  z-index: 21 !important;\r\n}\r\n\r\n#LightDarkModeButton,\r\n#AddedSettings {\r\n  z-index: 22 !important;\r\n}\r\n\r\n#menu {\r\n  background: var(--vro-glass) !important;\r\n  color: var(--text-primary) !important;\r\n  border-right: 1px solid var(--vro-border) !important;\r\n  box-shadow: 8px 0 32px rgba(0, 0, 0, 0.28) !important;\r\n  backdrop-filter: blur(22px) saturate(1.15);\r\n}\r\n\r\n#menu * {\r\n  color: var(--text-primary) !important;\r\n}\r\n\r\n#menu li:hover,\r\n#menu section:hover {\r\n  background: color-mix(in srgb, var(--better-main) 18%, transparent) !important;\r\n}\r\n\r\n#menu li.active,\r\n#menu section.active {\r\n  background: color-mix(in srgb, var(--better-main) 28%, transparent) !important;\r\n  box-shadow: inset 4px 0 0 var(--better-main);\r\n}\r\n\r\n#main {\r\n  background: transparent !important;\r\n  color: var(--text-primary) !important;\r\n}\r\n\r\n#main > .dashboard section,\r\n.dashlet,\r\n.notice,\r\n.document,\r\n.dashboard > div,\r\n.dashboard > .message,\r\n.timetable-container,\r\n.notices-container,\r\n.shortcut-container > .border,\r\n#home-container > div {\r\n  background: var(--vro-glass) !important;\r\n  color: var(--text-primary) !important;\r\n  border: 1px solid var(--vro-border) !important;\r\n  border-radius: 14px !important;\r\n  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.32) !important;\r\n  backdrop-filter: blur(18px) saturate(1.1);\r\n}\r\n\r\n#main > .dashboard section *,\r\n.dashlet *,\r\n.notice *,\r\n.document * {\r\n  color: var(--text-primary) !important;\r\n}\r\n\r\n.shortcut {\r\n  background: var(--vro-glass-soft) !important;\r\n  border: 1px solid var(--vro-border) !important;\r\n  border-radius: 12px !important;\r\n  backdrop-filter: blur(14px);\r\n}\r\n\r\n.day,\r\n.quickbar {\r\n  background: var(--vro-glass) !important;\r\n  border: 1px solid var(--vro-border) !important;\r\n  border-radius: 12px !important;\r\n  backdrop-filter: blur(16px);\r\n}\r\n\r\n.uiButton,\r\n.addedButton,\r\n[class*=\"uiButton\"] {\r\n  background: var(--vro-glass-soft) !important;\r\n  border: 1px solid var(--vro-border) !important;\r\n  border-radius: 10px !important;\r\n  color: var(--text-primary) !important;\r\n  backdrop-filter: blur(12px);\r\n}\r\n\r\n.addedButton svg,\r\n.addedButton svg path,\r\n.addedButton svg g,\r\n#LightDarkModeButton svg,\r\n#LightDarkModeButton svg path,\r\n#AddedSettings svg,\r\n#AddedSettings svg path {\r\n  fill: var(--text-primary) !important;\r\n  color: var(--text-primary) !important;\r\n}\r\n\r\ninput,\r\nselect,\r\ntextarea {\r\n  background: color-mix(in srgb, var(--background-primary) 92%, transparent) !important;\r\n  border: 1px solid var(--vro-border) !important;\r\n  color: var(--text-primary) !important;\r\n  border-radius: 10px !important;\r\n}\r\n\r\na {\r\n  color: color-mix(in srgb, var(--better-main) 85%, white) !important;\r\n}\r\n\r\nhtml.dark a {\r\n  color: color-mix(in srgb, var(--better-main) 90%, white) !important;\r\n}\r\n\r\n[class*=\"MessageList__MessageList___\"],\r\n[class*=\"BasicPanel__BasicPanel___\"] {\r\n  background: var(--vro-glass) !important;\r\n  border: 1px solid var(--vro-border) !important;\r\n  border-radius: 14px !important;\r\n  backdrop-filter: blur(16px);\r\n}\r\n","images":[{"id":"vro-bg-fallback","variableName":"vro-bg-fallback","data":""}],"coverImage":""}